{
  "name": "kilimanjaro-schools",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:endpoints:inventory": "node scripts/endpoint-inventory.js",
    "test:e2e:live": "node scripts/live-e2e-smoke.js",
    "seed:production-demo": "node scripts/seed-production-demo.js",
    "dev:gateway": "npm run dev --workspace=services/api-gateway",
    "dev:auth": "npm run dev --workspace=services/auth-service",
    "dev:student": "npm run dev --workspace=services/student-service",
    "dev:academic": "npm run dev --workspace=services/academic-service",
    "dev:finance": "npm run dev --workspace=services/finance-service",
    "dev:notification": "npm run dev --workspace=services/notification-service",
    "dev:analytics": "npm run dev --workspace=services/analytics-service"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.10",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
