generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]
}

enum Role {
  SYSTEM_ADMIN
  BOARD_DIRECTOR
  MANAGING_DIRECTOR
  PRINCIPAL
  ACADEMIC_QA
  FINANCE
  HEAD_OF_DEPARTMENT
  TEACHER
  PARENT
  STUDENT

  @@schema("auth")
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESHED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  USER_CREATED
  USER_DEACTIVATED
  USER_ACTIVATED
  USER_ROLE_CHANGED
  USER_PROFILE_UPDATED
  USER_EMAIL_CHANGED
  USER_SCHOOL_CHANGED
  USER_ROLES_CHANGED
  USERS_IMPORTED

  @@schema("auth")
}

model User {
  id                   String               @id @default(uuid())
  email                String?              @unique
  registrationNumber   String?              @unique
  passwordHash         String
  schoolId             String?
  school               School? @relation(fields: [schoolId], references: [id])
  roles                UserRoleAssignment[]
  tokenVersion         Int @default(1)
  role                 Role
  firstName            String
  lastName             String
  department           String?
  phoneNumber          String?
  isActive             Boolean              @default(true)
  isEmailVerified      Boolean              @default(false)
  mustChangePassword   Boolean              @default(false)
  failedLoginAttempts  Int                  @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  createdBy            String?
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]

  @@index([schoolId, isActive])
  @@index([role, isActive])
  @@index([createdAt])
  @@map("users")
  @@schema("auth")
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  isRevoked  Boolean  @default(false)

  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("auth")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash    String
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  ipAddress  String?

  @@index([userId, isUsed])
  @@index([expiresAt])
  @@map("password_reset_tokens")
  @@schema("auth")
}

model AuditLog {
  id         String       @id @default(uuid())
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([userId])
  @@index([action, createdAt])
  @@map("audit_logs")
  @@schema("auth")
}

model School {
  id String @id @default(uuid())
  code String @unique
  name String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  @@map("schools")
  @@schema("auth")
}

model UserRoleAssignment {
  id String @id @default(uuid())
  userId String
  role Role
  assignedBy String?
  assignedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, role])
  @@index([role, userId])
  @@map("user_role_assignments")
  @@schema("auth")
}

model ImportBatch {
 id String @id
 schoolId String
 actorId String
 fingerprint String
 result Json
 createdAt DateTime @default(now())
 @@index([schoolId])
 @@map("import_batches")
 @@schema("auth")
}
