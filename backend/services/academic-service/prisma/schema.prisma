generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["academics"]
}

enum AssessmentStatus {
  DRAFT
  OPEN
  MARKS_ENTERED
  SUBMITTED
  HOD_APPROVED
  APPROVED
  REJECTED
  LOCKED

  @@schema("academics")
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  REOPENED
  LOCKED
  UNLOCKED
  EDITED

  @@schema("academics")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY

  @@schema("academics")
}

enum VenueType {
  CLASSROOM
  HALL
  SPORTS_GROUND
  LABORATORY
  LIBRARY
  MUSIC_ROOM
  COMPUTER_LAB
  OTHER

  @@schema("academics")
}

enum TimetableType {
  CLASS
  EXTRACURRICULAR
  CUSTOM

  @@schema("academics")
}

enum SlotActivityType {
  LESSON
  BREAK
  ASSEMBLY
  SPORTS
  CLUB
  ARTS
  MUSIC
  EXAM
  CUSTOM

  @@schema("academics")
}

enum InterventionType {
  ALERT_RESOLVED
  ALERT_ESCALATED
  PAIRING_ACTIVATED
  PAIRING_REJECTED
  PAIRING_COMPLETED
  MANUAL_PAIRING_CREATED
  TEACHER_SUPPORT_GIVEN
  PARENT_MEETING_SCHEDULED
  ADDITIONAL_LESSONS_ASSIGNED
  OTHER

  @@schema("academics")
}

enum EducationStage {
  NURSERY
  PRE_UNIT
  PRIMARY
  O_LEVEL
  A_LEVEL

  @@schema("academics")
}

/// Lifecycle of an Exam Window (the new exam lifecycle orchestrator).
/// DRAFT     → created, assessments not yet fanned out / not visible to teachers
/// OPEN      → teachers can enter/upload & submit marks for their subjects
/// CLOSED    → entry locked; merit list computed
/// PUBLISHED → results visible to students/parents; analytics fired
/// REOPENED  → temporarily unlocked for an approved edit request
/// ARCHIVED  → retired from active lists
enum ExamWindowStatus {
  DRAFT
  OPEN
  CLOSED
  PUBLISHED
  REOPENED
  ARCHIVED

  @@schema("academics")
}

/// How an Exam Window selects the classes it applies to.
/// ALL_CLASSES → every active class in the academic year (optionally stage-filtered)
/// STANDARDS   → all streams of the listed levels (e.g. Class 6 = level 6 → 6A/6B/6C)
/// STREAMS     → an explicit list of class ids (individual streams)
enum ExamWindowScopeType {
  ALL_CLASSES
  STANDARDS
  STREAMS

  @@schema("academics")
}

/// Lifecycle of a teacher's request to edit already-submitted/locked results.
enum ResultEditRequestStatus {
  REQUESTED
  GRANTED
  REJECTED
  COMPLETED
  REPUBLISHED

  @@schema("academics")
}

/// Role of a subject inside an A-Level combination.
/// COMPULSORY_SUBSIDIARY marks General Studies / General Paper which every
/// ACSEE candidate must sit regardless of their principal combination.
enum SubjectRole {
  PRINCIPAL
  SUBSIDIARY
  COMPULSORY_SUBSIDIARY

  @@schema("academics")
}

model Subject {
  id                  String                      @id @default(uuid())
  name                String
  code                String                      @unique
  description         String?
  educationStage      EducationStage?
  isCompulsory        Boolean                     @default(true)
  isActive            Boolean                     @default(true)
  departmentId        String?
  department          String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  classSubjects       ClassSubject[]
  combinationSubjects SubjectCombinationSubject[]
  studentEnrollments  StudentSubjectEnrollment[]
  assessments         Assessment[]
  timetable           Timetable[]

  @@schema("academics")
}

model ClassSubject {
  id             String              @id @default(uuid())
  schoolId       String?
  classId        String
  subjectId      String
  academicYearId String
  teacherId      String
  educationStage EducationStage      @default(O_LEVEL)
  classLevel     Int?
  combinationId  String?
  periodsPerWeek Int                 @default(4)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  subject        Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  combination    SubjectCombination? @relation(fields: [combinationId], references: [id], onDelete: SetNull)
  assessments    Assessment[]
  marks          Mark[]
  termResults    TermResult[]
  syllabus       SyllabusTracker[]

  @@unique([classId, subjectId, academicYearId, combinationId])
  @@index([classId, academicYearId])
  @@index([educationStage, classLevel, academicYearId])
  @@index([combinationId])
  @@index([teacherId])
  @@schema("academics")
}

model GradingScale {
  id             String          @id @default(uuid())
  schoolId       String?
  name           String
  academicYearId String
  educationStage EducationStage?
  classLevel     Int?
  subjectId      String?
  isActive       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  grades         GradeBoundary[]

  @@index([academicYearId, educationStage, classLevel, subjectId, isActive])
  @@schema("academics")
}

model GradeBoundary {
  id             String       @id @default(uuid())
  gradingScaleId String
  grade          String
  minScore       Float
  maxScore       Float
  points         Float
  remark         String
  isPassing      Boolean      @default(true)
  gradingScale   GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  @@unique([gradingScaleId, grade])
  @@index([gradingScaleId, minScore, maxScore])
  @@schema("academics")
}

model AssessmentType {
  id               String          @id @default(uuid())
  name             String
  code             String
  weightPercentage Float
  academicYearId   String
  educationStage   EducationStage?
  classLevel       Int?
  subjectId        String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  assessments      Assessment[]

  @@unique([code, academicYearId, educationStage, classLevel, subjectId])
  @@index([academicYearId, educationStage, classLevel, subjectId, isActive])
  @@schema("academics")
}

model Assessment {
  id               String           @id @default(uuid())
  schoolId         String?
  classSubjectId   String
  /// Legacy weighting-based flow. NULL for exam-window assessments, which
  /// derive their type from the parent ExamWindow's ExamType instead.
  assessmentTypeId String?
  /// Set when this assessment belongs to an Exam Window (new exam lifecycle).
  examWindowId     String?
  subjectId        String
  classId          String
  educationStage   EducationStage   @default(O_LEVEL)
  classLevel       Int?
  combinationId    String?
  termId           String
  academicYearId   String
  name             String
  maxScore         Float            @default(100)
  date             DateTime?
  status           AssessmentStatus @default(DRAFT)
  submittedAt      DateTime?
  submittedById    String?
  approvedAt       DateTime?
  approvedById     String?
  rejectedAt       DateTime?
  rejectedById     String?
  rejectionReason  String?
  lockedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  classSubject     ClassSubject     @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  assessmentType   AssessmentType?  @relation(fields: [assessmentTypeId], references: [id])
  examWindow       ExamWindow?      @relation(fields: [examWindowId], references: [id], onDelete: Cascade)
  subject          Subject          @relation(fields: [subjectId], references: [id])
  marks            Mark[]
  approvalLogs     ApprovalLog[]

  @@unique([classSubjectId, assessmentTypeId, termId])
  @@unique([classSubjectId, examWindowId])
  @@index([classId, termId, status])
  @@index([educationStage, classLevel, academicYearId])
  @@index([combinationId])
  @@index([examWindowId, status])
  @@schema("academics")
}

model Mark {
  id             String       @id @default(uuid())
  assessmentId   String
  classSubjectId String
  studentId      String
  score          Float
  isAbsent       Boolean      @default(false)
  note           String?
  enteredById    String
  enteredAt      DateTime     @default(now())
  lastEditedById String?
  lastEditedAt   DateTime?
  isLocked       Boolean      @default(false)
  assessment     Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId])
  @@schema("academics")
}

model TermResult {
  id                   String         @id @default(uuid())
  schoolId             String?
  studentId            String
  classId              String
  classSubjectId       String
  subjectId            String
  subjectName          String
  educationStage       EducationStage @default(O_LEVEL)
  classLevel           Int?
  combinationId        String?
  termId               String
  academicYearId       String
  assessmentScores     Json
  weightedTotal        Float
  grade                String
  gradePoints          Float
  remark               String
  isPassing            Boolean
  rank                 Int?
  totalStudentsInClass Int?
  teacherId            String
  isPublished          Boolean        @default(false)
  publishedAt          DateTime?
  publishedById        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  classSubject         ClassSubject   @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, classSubjectId, termId])
  @@index([studentId, termId])
  @@index([classId, termId])
  @@index([educationStage, classLevel, termId])
  @@index([combinationId, termId])
  @@schema("academics")
}

model ReportCard {
  id                   String         @id @default(uuid())
  schoolId             String?
  studentId            String
  classId              String
  educationStage       EducationStage @default(O_LEVEL)
  classLevel           Int?
  combinationId        String?
  termId               String
  academicYearId       String
  overallAverage       Float
  overallGrade         String
  overallPoints        Float
  overallRemark        String
  reportTemplateCode   String?
  divisionSummary      Json?
  rank                 Int?
  totalStudentsInClass Int?
  subjectCount         Int
  failingSubjectCount  Int
  teacherComment       String?
  principalComment     String?
  principalSignedAt    DateTime?
  principalSignedById  String?
  pdfUrl               String?
  pdfGeneratedAt       DateTime?
  isPublished          Boolean        @default(false)
  publishedAt          DateTime?
  publishedById        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  /// Gap 12 ── Primary holistic assessment fields
  behaviourGrade       String?
  socialSkillsGrade    String?
  extraCurricularNote  String?
  readingAbility       String?
  writingAbility       String?
  numeracyAbility      String?

  @@unique([studentId, termId])
  @@index([classId, termId])
  @@index([educationStage, classLevel, termId])
  @@index([combinationId, termId])
  @@schema("academics")
}

model SubjectCombination {
  id                 String                      @id @default(uuid())
  schoolId           String?
  code               String
  name               String
  educationStage     EducationStage              @default(A_LEVEL)
  academicYearId     String
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  subjects           SubjectCombinationSubject[]
  classSubjects      ClassSubject[]
  studentEnrollments StudentSubjectEnrollment[]

  // Uniqueness is enforced at DB level by a COALESCE-based index (see migration)
  // that treats NULL schoolId as group-wide combinations.
  @@index([code, academicYearId, schoolId])
  @@index([educationStage, academicYearId, isActive])
  @@schema("academics")
}

model SubjectCombinationSubject {
  id            String             @id @default(uuid())
  combinationId String
  subjectId     String
  /// Kept for backward compatibility. Prefer subjectRole going forward.
  isPrincipal   Boolean            @default(true)
  /// Semantic role of this subject in the combination.
  subjectRole   SubjectRole        @default(PRINCIPAL)
  displayOrder  Int                @default(0)
  combination   SubjectCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  subject       Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([combinationId, subjectId])
  @@index([subjectId])
  @@index([combinationId, subjectRole])
  @@schema("academics")
}

model StudentSubjectEnrollment {
  id             String              @id @default(uuid())
  studentId      String
  classId        String
  subjectId      String
  academicYearId String
  termId         String?
  combinationId  String?
  isActive       Boolean             @default(true)
  enrolledAt     DateTime            @default(now())
  subject        Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  combination    SubjectCombination? @relation(fields: [combinationId], references: [id], onDelete: SetNull)

  @@unique([studentId, subjectId, academicYearId, termId])
  @@index([studentId, academicYearId, isActive])
  @@index([classId, academicYearId, isActive])
  @@index([combinationId, academicYearId])
  @@schema("academics")
}

model ApprovalLog {
  id              String         @id @default(uuid())
  assessmentId    String
  action          ApprovalAction
  performedById   String
  performedByRole String
  note            String?
  createdAt       DateTime       @default(now())
  assessment      Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, createdAt])
  @@schema("academics")
}

model Timetable {
  id             String    @id @default(uuid())
  schoolId       String?
  classId        String
  subjectId      String
  teacherId      String
  termId         String
  academicYearId String
  /// For A-Level: restrict this slot to a specific subject combination.
  /// NULL means the slot applies to the whole class (Primary / O-Level).
  combinationId  String?
  dayOfWeek      DayOfWeek
  startTime      String
  endTime        String
  room           String?
  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([classId, termId])
  @@index([combinationId])
  @@schema("academics")
}

model SyllabusTracker {
  id                   String       @id @default(uuid())
  classSubjectId       String
  termId               String
  totalTopics          Int
  coveredTopics        Int          @default(0)
  completionPercentage Float        @default(0)
  lastUpdatedById      String
  notes                String?
  updatedAt            DateTime     @updatedAt
  classSubject         ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  @@unique([classSubjectId, termId])
  @@schema("academics")
}

model AcademicIntervention {
  id              String           @id @default(uuid())
  schoolId        String?
  alertId         String?
  pairingId       String?
  studentId       String
  subjectId       String?
  subjectName     String?
  type            InterventionType
  performedById   String
  performedByRole String
  note            String
  outcome         String?
  followUpDate    DateTime?
  isFollowedUp    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([studentId])
  @@index([schoolId])
  @@index([performedById])
  @@schema("academics")
}

model AcademicAuditLog {
  id            String   @id @default(uuid())
  schoolId      String?
  action        String
  performedById String
  payload       Json
  createdAt     DateTime @default(now())

  @@index([schoolId])
  @@index([performedById])
  @@schema("academics")
}

// ─── Timetable System ─────────────────────────────────────────────────────────

model Venue {
  id          String          @id @default(uuid())
  schoolId    String?
  name        String
  type        VenueType       @default(CLASSROOM)
  capacity    Int             @default(40)
  /// Stage filter: empty array = available to all stages. e.g. ["PRIMARY","O_LEVEL"]
  stageFilter String[]
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  slots       TimetableSlot[]

  @@schema("academics")
}

model TimetableActivity {
  id              String           @id @default(uuid())
  name            String
  activityType    SlotActivityType @default(LESSON)
  defaultDuration Int              @default(40)
  /// Stages this activity applies to; empty = all
  stageFilter     String[]
  description     String?
  colorCode       String?          @default("#4338CA")
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  slots           TimetableSlot[]

  @@schema("academics")
}

model TimetableSheet {
  id             String          @id @default(uuid())
  schoolId       String?
  name           String
  timetableType  TimetableType   @default(CLASS)
  /// Stage scope: NURSERY | PRE_UNIT | PRIMARY | O_LEVEL | A_LEVEL | null = ALL
  stage          String?
  classId        String?
  className      String?
  academicYearId String
  termId         String?
  isPublished    Boolean         @default(false)
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  slots          TimetableSlot[]

  @@index([academicYearId, timetableType])
  @@schema("academics")
}

model TimetableSlot {
  id            String             @id @default(uuid())
  sheetId       String
  sheet         TimetableSheet     @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  dayOfWeek     DayOfWeek
  startTime     String // "08:00"
  endTime       String // "08:40"
  activityType  SlotActivityType   @default(LESSON)
  label         String? // display label — subject name, "Assembly", "Break", etc.
  activityId    String?
  activity      TimetableActivity? @relation(fields: [activityId], references: [id])
  subjectId     String?
  subjectName   String?
  teacherId     String?
  teacherName   String?
  classId       String?
  className     String?
  venueId       String?
  venue         Venue?             @relation(fields: [venueId], references: [id])
  combinationId String?
  /// Extra-curricular: participant class IDs, student group IDs, etc.
  attendeeIds   String[]
  /// Staff IDs responsible for this slot
  staffIds      String[]
  staffNames    String[]
  notes         String?
  colorCode     String?

  createdAt DateTime @default(now())

  @@index([sheetId, dayOfWeek])
  @@schema("academics")
}

// ─── Exam Lifecycle ─────────────────────────────────────────────────────────

/// Admin-managed catalogue of exam types (a.k.a. exam-window types):
/// Weekly, Monthly, Midterm, Terminal, Remedial, Mock, etc.
/// `defaultWeight` is the contribution this type carries when its windows are
/// selected to compose a term report card (weighting happens only at report-card
/// composition time — never during marks entry).
model ExamType {
  id             String          @id @default(uuid())
  schoolId       String?
  name           String
  code           String
  description    String?
  /// Report-card composition weight (0–100). 100 = a single window fills the card.
  defaultWeight  Float           @default(100)
  /// Optional narrowing of where this type applies. NULL = all.
  educationStage EducationStage?
  color          String?         @default("#4338CA")
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  windows        ExamWindow[]

  @@index([schoolId, isActive])
  @@index([code])
  @@schema("academics")
}

/// The orchestrating aggregate. An admin/principal/AQA opens a window for a term,
/// picks the exam type + scope (all classes / standards / individual streams),
/// and the system fans out one Assessment per class-subject in scope. Teachers
/// then see their open windows and fill marks. On close the cross-subject merit
/// list is computed; on publish results reach students/parents and analytics.
model ExamWindow {
  id                 String              @id @default(uuid())
  schoolId           String?
  examTypeId         String
  name               String
  academicYearId     String
  termId             String
  educationStage     EducationStage?
  scopeType          ExamWindowScopeType @default(ALL_CLASSES)
  /// For STANDARDS scope: the class levels covered (e.g. [6] → all Class 6 streams).
  scopeLevels        Int[]
  /// For STREAMS scope: explicit class ids.
  scopeClassIds      String[]
  status             ExamWindowStatus    @default(DRAFT)
  /// Default per-subject maximum score for the whole window (individual
  /// assessments may still override their own maxScore).
  maxScore           Float               @default(100)
  /// Report-card composition weight (seeded from ExamType.defaultWeight, overridable).
  weight             Float               @default(100)
  /// Whether this window is eligible to be selected into a term report card.
  countsToReportCard Boolean             @default(true)
  instructions       String?
  opensAt            DateTime?
  closesAt           DateTime?
  openedAt           DateTime?
  closedAt           DateTime?
  computedAt         DateTime?
  publishedAt        DateTime?
  publishedById      String?
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  examType           ExamType            @relation(fields: [examTypeId], references: [id])
  assessments        Assessment[]
  results            ExamWindowResult[]
  editRequests       ResultEditRequest[]

  @@index([schoolId, academicYearId, termId])
  @@index([status])
  @@index([examTypeId])
  @@schema("academics")
}

/// Per-student, per-window cross-subject rollup — the merit-list row.
/// This is the new ranking dimension (distinct from per-subject TermResult and
/// per-term ReportCard): one exam event ranked across all subjects, at two
/// granularities — stream (one class) and standard (all streams of a level).
model ExamWindowResult {
  id                 String         @id @default(uuid())
  schoolId           String?
  examWindowId       String
  studentId          String
  classId            String
  className          String?
  stream             String?
  classLevel         Int?
  educationStage     EducationStage @default(PRIMARY)
  registrationNumber String?
  studentName        String?
  gender             String?
  /// { [subjectId]: { subjectName, code, score, maxScore, grade, points, isAbsent } }
  subjectScores      Json
  subjectCount       Int            @default(0)
  total              Float          @default(0)
  mean               Float          @default(0)
  meanPoints         Float          @default(0)
  overallGrade       String         @default("")
  overallPoints      Float          @default(0)
  overallRemark      String         @default("")
  isPassing          Boolean        @default(false)
  /// DEV column: deviation of this student's mean from their STREAM mean (signed).
  classMeanDev       Float          @default(0)
  /// Deviation of this student's mean from their STANDARD (level) mean (signed).
  standardMeanDev    Float          @default(0)
  /// Enrichment: this student's mean in the previous window of the term, and the change.
  prevWindowMean     Float?
  prevWindowDelta    Float?
  /// STR POS — position within the stream (one class).
  streamRank         Int?
  streamTotal        Int?
  /// OVR POS — position within the standard (all streams of the level).
  standardRank       Int?
  standardTotal      Int?
  isPublished        Boolean        @default(false)
  publishedAt        DateTime?
  computedAt         DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  examWindow         ExamWindow     @relation(fields: [examWindowId], references: [id], onDelete: Cascade)

  @@unique([examWindowId, studentId])
  @@index([examWindowId, classId])
  @@index([examWindowId, classLevel])
  @@index([studentId])
  @@schema("academics")
}

/// A teacher's request to edit results after submission/lock. Admin grants →
/// the affected assessment(s) unlock and the window/results unpublish; after the
/// edit the admin republishes.
model ResultEditRequest {
  id              String                  @id @default(uuid())
  schoolId        String?
  examWindowId    String
  assessmentId    String?
  classSubjectId  String?
  subjectId       String?
  classId         String?
  requestedById   String
  requestedByRole String
  reason          String
  status          ResultEditRequestStatus @default(REQUESTED)
  decidedById     String?
  decidedByRole   String?
  decidedAt       DateTime?
  decisionNote    String?
  completedAt     DateTime?
  republishedAt   DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  examWindow      ExamWindow              @relation(fields: [examWindowId], references: [id], onDelete: Cascade)

  @@index([examWindowId, status])
  @@index([requestedById])
  @@index([schoolId, status])
  @@schema("academics")
}

/// Records an admin's choice of WHICH exam windows (and their weights) compose
/// the term report cards for a scope, so a report card is auditable and the
/// composition is repeatable. Generation blends the selected windows into
/// TermResult, then the existing report-card generator builds the cards/PDFs.
model ReportCardComposition {
  id                   String    @id @default(uuid())
  schoolId             String?
  name                 String?
  academicYearId       String
  termId               String
  /// Scope narrowing (both optional): a single standard level and/or explicit classes.
  scopeLevel           Int?
  scopeClassIds        String[]
  /// [{ examWindowId, weight, name }] — the windows blended into the report card.
  windowSelections     Json
  status               String    @default("GENERATED")
  classesGenerated     Int       @default(0)
  studentsGenerated    Int       @default(0)
  reportCardsGenerated Int       @default(0)
  generatedById        String?
  generatedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([schoolId, termId])
  @@index([academicYearId, termId])
  @@schema("academics")
}
