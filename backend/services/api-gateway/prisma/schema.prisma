generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["operations"]
}

model OperationRecord {
  schoolId String @default("00000000-0000-4000-8000-000000000001")
  @@index([schoolId])

  collection String
  id         String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([collection, id])
  @@index([collection, updatedAt])
  @@map("operation_records")
  @@schema("operations")
}
